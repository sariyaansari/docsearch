# ═══════════════════════════════════════════════════════════════════════════
# Deployment credentials — copy this file to `.env.deploy` and fill in values.
# `.env.deploy` is git-ignored. NEVER commit real credentials to a repo,
# including this repo — that's the whole reason this file is separate from
# deploy.sh (which contains no secrets and is safe to commit).
#
# PREP ORDER — get these in this sequence, each one unblocks the next:
#
#   1. GitHub Personal Access Token
#      → github.com/settings/tokens → "Generate new token (classic)"
#      → Scopes needed: repo, write:packages, read:packages
#      → Used for: pushing your code AND pushing the Docker image to GHCR
#        (ghcr.io) using the GitHub account you already need for submission —
#        this avoids requiring a separate Docker Hub account.
#
#   2. Neon API key (Postgres)
#      → console.neon.tech → sign up (free) → Account Settings → API Keys
#        → "Create API key"
#      → Used for: provisioning a free serverless Postgres project via API
#
#   3. Upstash API key (Redis)
#      → console.upstash.com → sign up (free) → Account → Management API
#        → "Create API Key"
#      → Also grab your Upstash account EMAIL — the API uses email+key
#        (HTTP Basic auth), not the key alone
#      → Used for: provisioning a free Redis database via API
#
#   4. Render API key + Workspace (owner) ID
#      → dashboard.render.com → sign up (free, can use "Sign in with GitHub"
#        to reuse credential #1's account) → Account Settings → API Keys
#        → "Create API Key"
#      → Workspace ID: Dashboard → your workspace name (top-left) → Settings
#        → copy the ID starting with "tea-" or "usr-"
#      → Used for: creating the web service and (if your image is private)
#        a registry credential so Render can pull it from GHCR
#
# Nothing here is hardcoded into deploy.sh itself — the script only ever
# reads these as environment variables at run time.
# ═══════════════════════════════════════════════════════════════════════════

# --- 1. GitHub / GHCR ---
GITHUB_USERNAME=""              # e.g. jane-doe
GITHUB_TOKEN=""                 # ghp_xxxxxxxxxxxxxxxxxxxx
GHCR_IMAGE_NAME="docsearch-api" # image will be ghcr.io/<username>/<this>

# --- 2. Neon (Postgres) ---
NEON_API_KEY=""
NEON_PROJECT_NAME="docsearch-prod"
NEON_REGION="aws-us-east-1"      # see: neon.tech/docs/introduction/regions
NEON_PG_VERSION="16"

# --- 3. Upstash (Redis) ---
UPSTASH_EMAIL=""                 # the email you signed up to Upstash with
UPSTASH_API_KEY=""
UPSTASH_DB_NAME="docsearch-cache"
UPSTASH_REGION="us-east-1"

# --- 4. Render (hosting) ---
RENDER_API_KEY=""
RENDER_OWNER_ID=""                # starts with "tea-" (team) or "usr-" (personal)
RENDER_SERVICE_NAME="docsearch-api"
RENDER_REGION="oregon"            # oregon | frankfurt | singapore | ohio | virginia

# --- Populated automatically by the script as it runs (leave blank initially) ---
# The script writes discovered IDs/URLs back into this file so re-running
# deploy.sh after a partial failure skips steps that already succeeded.
NEON_PROJECT_ID=""
NEON_CONNECTION_URI=""
UPSTASH_DATABASE_ID=""
UPSTASH_REDIS_URL=""
RENDER_REGISTRY_CREDENTIAL_ID=""
RENDER_SERVICE_ID=""
RENDER_SERVICE_URL=""
